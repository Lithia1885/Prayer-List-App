          "type": "Compose",
          "inputs": "@if(empty(body('Select_World_Rows')), '<tr><td class=\"entry\"><span class=\"empty-note\">No active entries this week.</span></td></tr>', join(body('Select_World_Rows'), ''))"
        },
        "Load_Template": {
          "runAfter": {
            "HTML_Members_Block": [
              "Succeeded"
            ],
            "HTML_Textin_Block": [
              "Succeeded"
            ],
            "HTML_Homebound_Block": [
              "Succeeded"
            ],
            "HTML_World_Block": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "d88fe6f1-6245-4849-9aa0-9191897218cd"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot",
              "path": "/Shared Documents/Templates/prayer_list_template.html",
              "inferContentType": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetFileContentByPath"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Build_Final_HTML": {
          "runAfter": {
            "Load_Template": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a7b1473c-4fe3-42ba-abd2-df1dcff7279a"
          },
          "type": "Compose",
          "inputs": "@replace(replace(replace(replace(replace(string(body('Load_Template')),'{{MEETING_DATE}}', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'M/d/yyyy')),'{{MEMBERS_ROWS}}', outputs('HTML_Members_Block')),'{{TEXTIN_ROWS}}', outputs('HTML_Textin_Block')),'{{HOMEBOUND_ROWS}}', outputs('HTML_Homebound_Block')),'{{WORLD_ROWS}}', outputs('HTML_World_Block'))"
        },
        "Write_HTML_To_OneDrive": {
          "runAfter": {
            "Build_Final_HTML": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ecc83d6b-5bc6-4cf0-a12b-d88add1a0666"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "folderPath": "/Prayer List Staging",
              "name": "@{concat('bulletin_', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'yyyyMMdd'), '.html')}",
              "body": "@outputs('Build_Final_HTML')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "CreateFile"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "contentTransfer": {
              "transferMode": "Chunked"
            }
          }
        },
        "Delay": {
          "runAfter": {
            "Write_HTML_To_OneDrive": [
              "Succeeded"
