          "metadata": {
            "operationMetadataId": "21a46a42-2684-466d-8476-7c4b0fc2eb4e"
          },
          "type": "Compose",
          "inputs": "@if(empty(body('Select_Members_Rows')), '<tr><td class=\"entry\"><span class=\"empty-note\">No active entries this week.</span></td></tr>', join(body('Select_Members_Rows'), ''))"
        },
        "HTML_Textin_Block": {
          "runAfter": {
            "Select_Textin_Rows": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "92631640-afa5-4bf0-b899-6e91efffb5ca"
          },
          "type": "Compose",
          "inputs": "@if(empty(body('Select_Textin_Rows')), '<tr><td class=\"entry\"><span class=\"empty-note\">No active entries this week.</span></td></tr>', join(body('Select_Textin_Rows'), ''))"
        },
        "HTML_Homebound_Block": {
          "runAfter": {
            "Select_Homebound_Rows": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1dbf87e9-f4e6-4676-bc99-9b85709cb424"
          },
          "type": "Compose",
          "inputs": "@if(empty(body('Select_Homebound_Rows')), '<tr><td class=\"entry\"><span class=\"empty-note\">No active entries this week.</span></td></tr>', join(body('Select_Homebound_Rows'), ''))"
        },
        "HTML_World_Block": {
          "runAfter": {
            "Select_World_Rows": [
              "Succeeded"
            ]
