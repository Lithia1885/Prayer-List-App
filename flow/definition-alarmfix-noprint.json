      "actions": {
        "Get_Active_Entries": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "87c75cab-6ebc-4855-8ca9-52712b10f917"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot",
              "table": "176cec8e-c1a6-4319-a90a-e048ef4f19cf",
              "$filter": "Status eq 'Active' or Status eq 'Ongoing'",
              "$orderby": "LastUpdated desc, Title asc",
              "$top": 500
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Filter_Members": {
          "runAfter": {
            "Get_Active_Entries": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c8410321-2e6d-440e-be88-2edec66bdac0"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Get_Active_Entries')?['body/value']",
            "where": "@or(equals(item()?['Category/Value'], 'Member'), equals(item()?['Category/Value'], 'Family or Friend'))"
          }
        },
        "Filter_Textin": {
          "runAfter": {
            "Get_Active_Entries": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "7cb7a02a-5ac9-45c2-8269-db6ca6b0ec6e"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Get_Active_Entries')?['body/value']",
            "where": "@equals(item()?['Category/Value'], 'Text-in request')"
          }
        },
        "Filter_Homebound": {
          "runAfter": {
            "Get_Active_Entries": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "15a68d7f-d0be-4e4d-b47f-e46fdc8a0fac"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Get_Active_Entries')?['body/value']",
            "where": "@equals(item()?['Category/Value'], 'Homebound member')"
          }
        },
        "Filter_World": {
          "runAfter": {
            "Get_Active_Entries": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "d9c374a6-a4eb-43e5-b700-6846f467639c"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Get_Active_Entries')?['body/value']",
            "where": "@equals(item()?['Category/Value'], 'Nation or World')"
          }
        },
        "Select_Members_Rows": {
          "runAfter": {
            "Filter_Members": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "73912b44-6448-44d2-b359-bc9602d0ec4a"
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Filter_Members')",
            "select": "@concat('<tr><td class=\"entry\"><p><span class=\"name\">', item()?['Title'], '</span>', if(empty(item()?['Relationship']), '', concat(' (', item()?['Relationship'], ')')), if(empty(coalesce(item()?['Request'], '')), '', concat('<span class=\"dash\"> &#8211; </span>', item()?['Request'])), if(empty(item()?['LastUpdated']), '', concat(' (Updated ', formatDateTime(item()?['LastUpdated'], 'M/d/yy'), ')')), '</p></td></tr>')"
          }
        },
        "Select_Textin_Rows": {
          "runAfter": {
            "Filter_Textin": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ade21719-1be2-45b4-a3e3-300234154bdb"
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Filter_Textin')",
            "select": "@concat('<tr><td class=\"entry\"><p><span class=\"name\">', item()?['Title'], '</span>', if(empty(item()?['Relationship']), '', concat(' (', item()?['Relationship'], ')')), if(empty(coalesce(item()?['Request'], '')), '', concat('<span class=\"dash\"> &#8211; </span>', item()?['Request'])), if(empty(item()?['LastUpdated']), '', concat(' (Updated ', formatDateTime(item()?['LastUpdated'], 'M/d/yy'), ')')), '</p></td></tr>')"
          }
        },
        "Select_Homebound_Rows": {
          "runAfter": {
            "Filter_Homebound": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5f7c5f4f-32cd-4955-a30c-70f84880bada"
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Filter_Homebound')",
            "select": "@concat('<tr><td class=\"entry\"><p><span class=\"name\">', item()?['Title'], '</span>', if(empty(coalesce(item()?['Request'], '')), if(empty(item()?['Address']), '', concat('<span class=\"dash\"> &#8211; </span>', item()?['Address'])), concat('<span class=\"dash\"> &#8211; </span>', item()?['Request'])), '</p></td></tr>')"
          }
        },
        "Select_World_Rows": {
          "runAfter": {
            "Filter_World": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "484ea357-00ff-4bb5-9b08-d1b22145376d"
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Filter_World')",
            "select": "@concat('<tr><td class=\"entry\"><p><span class=\"name\">', item()?['Title'], '</span>', if(empty(item()?['Relationship']), '', concat(' (', item()?['Relationship'], ')')), if(empty(coalesce(item()?['Request'], '')), '', concat('<span class=\"dash\"> &#8211; </span>', item()?['Request'])), if(empty(item()?['LastUpdated']), '', concat(' (Updated ', formatDateTime(item()?['LastUpdated'], 'M/d/yy'), ')')), '</p></td></tr>')"
          }
        },
        "HTML_Members_Block": {
          "runAfter": {
            "Select_Members_Rows": [
              "Succeeded"
