          "type": "Wait",
          "inputs": {
            "interval": {
              "count": 15,
              "unit": "Second"
            }
          }
        },
        "Convert_To_PDF": {
          "runAfter": {
            "Delay": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f86eeb7d-006a-404c-a807-9fb6ae6b53d3"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "path": "@concat('/Prayer List Staging/bulletin_', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'yyyyMMdd'), '.html')",
              "type": "pdf"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "ConvertFileByPath"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Save_To_Archive": {
          "runAfter": {
            "Convert_To_PDF": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "2d355ca8-1709-4572-bba9-564c25f8f028"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot",
              "folderPath": "/Prayer List Archive",
              "name": "@{concat('prayer_list_', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'yyyyMMdd'), '.pdf')}",
              "body": "@body('Convert_To_PDF')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "CreateFile"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Send_Admin_Email": {
          "runAfter": {
            "Save_To_Archive": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f8b11bc4-7eec-4b9f-b74c-9dc547f8646d"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "office@lithiaspringsmethodist.org",
              "emailMessage/Subject": "@{concat('Prayer list ready to print — ', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'M/d/yyyy'))}",
              "emailMessage/Body": "<p class=\"editor-paragraph\">This week's prayer list is ready.</p><p class=\"editor-paragraph\"><br><a href=\"https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot/Prayer%20List%20Archive/Forms/AllItems.aspx\" class=\"editor-link\">You can find the most recent version (and all history) here.</a></p>",
              "emailMessage/From": "office@lithiaspringsmethodist.org",
              "emailMessage/Importance": "Normal"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365-1",
              "operationId": "SendEmailV2"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Delete_Temp_HTML": {
          "runAfter": {
            "Send_Admin_Email": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "6f27404b-7212-49a1-98f0-6d00af312533"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "id": "@outputs('Write_HTML_To_OneDrive')?['body/Id']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "DeleteFile"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Send_Failure_Email": {
          "runAfter": {
            "Delete_Temp_HTML": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "2046a4ae-767d-4775-93f6-48cc0d1ac692"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "bart.arther@lithiaspringsmethodist.org",
              "emailMessage/Subject": "⚠ Prayer list flow FAILED — manual backup needed",
              "emailMessage/Body": "<p>The weekly prayer-list flow did not finish cleanly.</p><p><a href=\"https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot/Prayer%20List%20Archive/Forms/AllItems.aspx\">Check the archive:</a> if today's PDF is there, only a late step failed. If it is missing, the list never generated — reprint last week's PDF or use the old-style Word doc as the manual fallback.</p>",
              "emailMessage/Importance": "High"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
