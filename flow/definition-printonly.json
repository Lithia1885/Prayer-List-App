          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "frequency": "Week",
            "interval": 1,
            "timeZone": "Eastern Standard Time",
            "startTime": "2026-04-29T18:00:00.000Z",
            "schedule": {
              "weekDays": [
                "Wednesday"
              ],
              "hours": [
                "13"
              ],
              "minutes": [
                0
              ]
            }
          },
          "evaluatedRecurrence": {
            "frequency": "Week",
            "interval": 1,
            "timeZone": "Eastern Standard Time",
            "startTime": "2026-04-29T18:00:00.000Z",
            "schedule": {
              "weekDays": [
                "Wednesday"
              ],
              "hours": [
                "13"
              ],
              "minutes": [
                0
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "f3d49aea-1dd3-493d-9174-320ff1f8ec68"
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Get_Archive_PDF": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "6dee5bf7-9f9c-4344-8ddb-ea160b80ee5c"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot",
              "path": "@concat('/Prayer List Archive/prayer_list_', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'yyyyMMdd'), '.pdf')",
              "inferContentType": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetFileContentByPath"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Print_On_Copier": {
          "runAfter": {
            "Get_Archive_PDF": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "880f0c27-61a5-47c8-8976-7ca9f0ff2334"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "getShareOption": "id",
              "share": "e3161c59-8a01-45e2-a108-0fff1aa19db1",
              "file": "@body('Get_Archive_PDF')",
              "fileName": "@{concat('prayer_list_', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'yyyyMMdd'), '.pdf')}",
              "fileType": "application/pdf",
              "duplexMode": "flipOnLongEdge",
              "finishings": [
                "stapleTopLeft"
              ],
              "colorMode": "grayscale",
              "copies": 5,
              "collate": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_universalprint",
              "connectionName": "shared_universalprint",
              "operationId": "PrintFile"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Send_Admin_Email": {
          "runAfter": {
            "Print_On_Copier": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f8b11bc4-7eec-4b9f-b74c-9dc547f8646d"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "office@lithiaspringsmethodist.org",
              "emailMessage/Subject": "@{concat('Prayer list printed — ', formatDateTime(convertTimeZone(utcNow(),'UTC','Eastern Standard Time'), 'M/d/yyyy'))}",
              "emailMessage/Body": "<p class=\"editor-paragraph\">This week's prayer list has been sent to the copier and should be waiting in the output tray.</p><p class=\"editor-paragraph\"><a href=\"https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot/Prayer%20List%20Archive/Forms/AllItems.aspx\" class=\"editor-link\">The PDF is also saved in the archive (and all past weeks are there too).</a></p><p class=\"editor-paragraph\">If it isn't in the tray, check that the copier is on and has paper, then print it from the archive link above.</p>",
              "emailMessage/From": "office@lithiaspringsmethodist.org",
              "emailMessage/Importance": "Normal"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365-1",
              "operationId": "SendEmailV2"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Send_Failure_Email": {
          "runAfter": {
            "Send_Admin_Email": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "2046a4ae-767d-4775-93f6-48cc0d1ac692"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "bart.arther@lithiaspringsmethodist.org",
              "emailMessage/Subject": "⚠ Prayer list flow FAILED — manual backup needed",
              "emailMessage/Body": "<p>The Wednesday print flow did not finish cleanly.</p><p><a href=\"https://lithiaspringsmethodist.sharepoint.com/sites/prayer-list-pilot/Prayer%20List%20Archive/Forms/AllItems.aspx\">Open the archive</a> and check for today's PDF:</p><p>— If it is missing, the GitHub render never produced it: check <a href=\"https://github.com/Lithia1885/Prayer-List-App/actions\">the workflow runs</a>, and print last week's PDF meanwhile.</p><p>— If it is there, the copier step likely failed: print it by hand and check the copier's queue and the flow run history.</p>",
              "emailMessage/Importance": "High"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      }
    },
